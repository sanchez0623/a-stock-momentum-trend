# ============================================================
# Momentum Trader 环境变量示例
# 复制为 .env 后按需修改; .env 不入库
# 配置读取优先级: env > 数据库配置 > 默认值
# ============================================================

# === 系统 ===
TZ=Asia/Shanghai
# 数据目录(容器内固定 /app/data, 挂载卷持久化)
DATA_DIR=./data

# === 数据源开关 (1=启用 0=禁用) ===
# 默认优先级: mootdx > tencent > baostock > eastmoney > lixinger > akshare
ENABLE_MOOTDX=1
ENABLE_TENCENT=1
ENABLE_BAOSTOCK=1
ENABLE_EASTMONEY=1
ENABLE_AKSHARE=1
ENABLE_LIXINGER=1

# === 理杏仁开放平台 (申万2021行业分级 + 日线K线兜底) ===
# 域名 open.lixinger.com; 限流 1000次/分, 36次/秒(超限返回 429, 已内置退避重试)
# - 分类刷新每次仅 2 次请求(行业列表 + 全量成分股), 手动触发(见 API source 参数)
# - 日线 K 线(前复权)作通用兜底源, 前 4 源健康时不会被调用
LIXINGER_TOKEN=

# === 东财风控专项 ===
# 注入 NID 令牌(从首页请求获取 cookie), 降低连接级风控概率
ENABLE_EASTMONEY_PATCH=1
# 东财请求间隔秒数(默认 2.0, 切勿低于 1.5)
EASTMONEY_INTERVAL_SEC=2.0
# HTTP 代理池, 逗号分隔, 轮换出口 IP(可选)
# PROXY_POOL=http://127.0.0.1:7890,http://127.0.0.1:7891

# === LLM (AI 复盘 LangChain 两步链, 兼容 OpenAI 协议) ===
# 两步链: Step1 行为特征归纳 -> Step2 基于特征生成建议; 依赖缺失时自动降级单步路径
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# === Embedding (AI 复盘记忆 RAG, SiliconFlow) ===
# 模型可选 BAAI/bge-m3 / BAAI/bge-large-zh-v1.5 等; ENABLED=1 启用记忆索引与检索
EMBEDDING_ENABLED=1
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# === 后端 ===
# uvicorn 监听端口(本项目约定 8002: 本机 8000 已被另一项目占用)
PORT=8002

# === 日志(结构化 JSON Lines, 默认 backend/logs/app.log, 按天轮转保留14天) ===
LOG_DIR=logs
LOG_LEVEL=INFO
